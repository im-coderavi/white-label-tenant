NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/toolzypro
JWT_ACCESS_SECRET=replace-with-a-random-32-char-minimum-secret
REFRESH_TOKEN_TTL_DAYS=30
SEED_MASTER_ADMIN_EMAIL=admin@toolzypro.local
SEED_MASTER_ADMIN_PASSWORD=change-me-please
STORAGE_DRIVER=local
CLOUDINARY_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@toolzypro.local
MOCK_WEBHOOK_SECRET=replace-with-a-random-secret
# 32+ char key used to encrypt reseller-supplied gateway/SMTP secrets at rest
SECRET_ENCRYPTION_KEY=replace-with-a-random-32-char-minimum-secret
# Platform-level Razorpay sandbox keys, used as a fallback when a reseller hasn't configured their own
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# DNS targets resellers must point their custom domain at (shown in Domain Management UI)
PLATFORM_TARGET_IP=
PLATFORM_CNAME_TARGET=
